            "exec": [
              "pm.test(\"HTTP 204\", () => { pm.response.to.have.status(204); });",
              "pm.test(\"Пустое тело\", () => { pm.expect(pm.response.text()).to.eql(''); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
